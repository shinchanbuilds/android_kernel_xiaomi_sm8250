# Localversion
CONFIG_LOCALVERSION="-🩸BloodReaper+"
CONFIG_LOCALVERSION_AUTO=n

# Spoof Uname
CONFIG_FAKE_UNAME_6_12=y

# Werror
CONFIG_CC_WERROR=n

# FS
CONFIG_UNICODE=y
CONFIG_SDCARD_FS=n

# CPU Mask
CONFIG_LITTLE_CPU_MASK=15
CONFIG_BIG_CPU_MASK=112
CONFIG_PRIME_CPU_MASK=128

# Devfreq Boost
CONFIG_DEVFREQ_BOOST=y
CONFIG_DEVFREQ_INPUT_BOOST_DURATION_MS=58
CONFIG_DEVFREQ_WAKE_BOOST_DURATION_MS=1000
CONFIG_DEVFREQ_CPU_LLCC_DDR_BW_BOOST_FREQ=2597

# Cpu Input Boost
CONFIG_CPU_BOOST=n
CONFIG_MSM_PERFORMANCE=n
CONFIG_QCOM_QHEE_ENABLE_MEM_PROTECTION=n
CONFIG_CPU_INPUT_BOOST=y
CONFIG_INPUT_BOOST_DURATION_MS=58
CONFIG_WAKE_BOOST_DURATION_MS=0
CONFIG_INPUT_BOOST_FREQ_LP=1708800
CONFIG_INPUT_BOOST_FREQ_PERF=1056000
CONFIG_INPUT_BOOST_FREQ_PRIME=1401600
CONFIG_MAX_BOOST_FREQ_LP=1804800
CONFIG_MAX_BOOST_FREQ_PERF=2246400
CONFIG_MAX_BOOST_FREQ_PRIME=2553600
CONFIG_CPU_FREQ_MIN_LP=300000
CONFIG_CPU_FREQ_MIN_PERF=710400
CONFIG_CPU_FREQ_MIN_PRIME=844800
CONFIG_CPU_FREQ_IDLE_LP=300000
CONFIG_CPU_FREQ_IDLE_PERF=710400
CONFIG_CPU_FREQ_IDLE_PRIME=844800

# Perf
CONFIG_PROFILING=n
CONFIG_PERF_EVENTS=y

# Frame
CONFIG_FRAME_WARN=0

# Qcom
CONFIG_QCOM_DCC_V2=n
