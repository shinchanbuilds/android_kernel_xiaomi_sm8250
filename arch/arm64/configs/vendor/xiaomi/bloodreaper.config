# Localversion
CONFIG_LOCALVERSION="-🩸BloodReaper+"
CONFIG_LOCALVERSION_AUTO=n

# Spoof Uname
CONFIG_FAKE_UNAME_6_12=y

# Werror
CONFIG_CC_WERROR=n

# FS
CONFIG_UNICODE=y
CONFIG_SDCARD_FS=n

# CPU Mask
CONFIG_LITTLE_CPU_MASK=15
CONFIG_BIG_CPU_MASK=112
CONFIG_PRIME_CPU_MASK=128

# Devfreq Boost
CONFIG_DEVFREQ_BOOST=y
CONFIG_DEVFREQ_INPUT_BOOST_DURATION_MS=58
CONFIG_DEVFREQ_WAKE_BOOST_DURATION_MS=0
CONFIG_DEVFREQ_CPU_LLCC_DDR_BW_BOOST_FREQ=2597
